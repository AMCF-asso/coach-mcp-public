{
  "name": "azerty-coach",
  "version": "0.1.0",
  "private": true,
  "description": "AZERTY Coach : taper n'importe quel caractère sur un clavier français, et apprendre l'AZERTY quand on vient d'un autre clavier. Serveur MCP en lecture seule.",
  "license": "EUPL-1.2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "data": "node scripts/build-data.ts",
    "data:check": "node scripts/build-data.ts --check",
    "widget": "node scripts/build-widget.ts",
    "widget:check": "node scripts/build-widget.ts --check",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "check": "npm run typecheck && npm test",
    "mcp": "node src/mcp/stdio.ts",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "@types/node": "24.19.0",
    "typescript": "7.0.2",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
